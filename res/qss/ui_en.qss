QWidget {
    background-color:#F1F0F5;
    font: 21px "Microsoft YaHei";
}

QPushButton {
    text-align: center;
    padding:10px;
    outline: none;
    background-color: white;
    border-color:#dfdfdf;
    border-width:2px;
    border-style:solid;
    border-radius: 10px;
    font: 21px "Microsoft YaHei";
}

QPushButton:pressed {
    color:white;
    padding-left:6px;
    padding-top:6px;
    background-color: #007454;
}

QToolButton {
    text-align: center;
    padding:10px;
    outline: none;
    background-color: white;
    border-color:#dfdfdf;
    border-radius: 10px;
    font: 14px "Microsoft YaHei";
}

QToolButton:pressed {
    color:white;
    padding-left:6px;
    padding-top:6px;
    background-color: #007454;
}

QLabel {
    background: transparent;
    font: 21px "Microsoft YaHei";
}

QGroupBox {
    border:1px solid lightgray;
    border-radius:10px;
    background-color:#FFFFFF;
    outline:0px;
}

QGroupBox:title {
    subcontrol-origin:magin;
    left:10px;
    top:10px;
}

QRadioButton::indicator {
    background:#FFFFFF;
    border:1px solid #B4BFC9;
    border-radius: 14px;
    width:26px;
    height:26px;
}

QRadioButton::indicator:checked {
    border:1px solid #1B63DC;
    background:#FFFFFF;
    image: url(:res/png/action_circle.png);
}

QRadioButton::indicator:hover {
    background:rgb(27,99,220,9);
    border:1px solid #1B63DC;
}

QComboBox {
    border:2px solid gray;
    border-color:#dfdfdf;
    border-radius:10px;
    padding:0px;
    background-color:#FFFFFF;
    combobox-popup:0;
}

QComboBox::drop-down {
    subcontrol-origin:padding;
    subcontrol-position:top right;
    width:50px;
    border-left-width:0px;
    border-left-color:darkgray;
    border-left-style:solid;
    border-top-right-radius:3px;
    border-bottom-right-radius:3px;
}

QComboBox::down-arrow {
    image:url(:/res/png/icon_down_arrow);
    width:20px;
    height:20px;
}

QListView {
    border:2px solid darkgray;
    outline:0px;
}

QListView::item {
    border:1px dotted gray;
    height:50px;
    background-color:white;
    color:black;
}

QListView::item:selected,QListView::item:selected:hover {
    background-color:rgb(100,188,130);
}

QScrollBar::add-page:horizontal,QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical {
    background: rgb(235,235,235);
}

QScrollBar::handle:vertical {
    width:50px;
    background-color:rgb(192,192,192);
    min-height:50px;
    border-radius:5px;
}

QScrollBar::handle:horizontal {
    background-color:rgb(192,192,192);
    min-width:20px;
    border-radius:17px;
}

QScrollBar::sub-line:vertical {
    background:rgb(235,235,235);
    border-image:url(:res/png/icon_up.png);
}

QScrollBar::add-line:vertical {
    background:rgb(235,235,235);
    border-image:url(:res/png/icon_down.png);
}

QScrollBar::sub-line:horizontal {
    background:url(:res/png/icon_left.png);
}

QScrollBar::add-line:horizontal {
    background:url(:res/png/icon_right.png);
}

QScrollBar:vertical {
    width:50px;
    background:lightgrey;
    margin:0px,0px,0px,0px;
    padding-top:50px;
    padding-bottom:50px;
}

QScrollBar:horizontal {
    height:34px;
    background:lightgrey;
    margin:0px,0px,0px,0px;
}

QTableView {
    color:black;
    background-color:white;
    gridline-color:black;
    border:0px solid gray;
    border-radius:5px;
    padding: 2px 4px;
    font: 20px "Microsoft YaHei";
}

QTableView::item {
    selection-background-color:rgb(0, 141, 75);
}

QHeaderView {
    color:white;
    background-color:rgb(0, 141, 75);
    border:0px solid gray;
    border-left-color:rgba(255,255,255,0);
    border-top-color:rgba(255,255,255,0);
    border-radius:5px;
    min-height:29px;
    font: 20px "Microsoft YaHei";
}

QHeaderView::section {
    color:white;
    background-color:rgb(0, 141, 75);
    border:2px solid gray;
    border-color:rgb(0, 141, 75);
}

QSlider::groove:horizontal,QSlider::groove:vertical {
    border-radius:6px;
    background:#F1F0F5;
    margin:0px 0px 0px 0px;
}

QSlider::handle:horizontal,QSlider::handle:vertical {
    background-color:rgb(255, 255, 255);
    border:1px solid #DFDFDF;
    width:20px;
    height:30px;
    margin:0px 0px 0px 0px;
    border-radius:5px;
}

QSlider::sub-page:horizontal {
    border-radius:5px;
    background:#007454;
}

QSlider::add-page:vertical {
    border-radius:5px;
    background:#007454;
}

QSlider::add-page:horizontal {
    border-radius:5px;
    background:#F1F0F5;
}

QSlider::sub-page:vertical {
    border-radius:5px;
    background:#F1F0F5;
}

QDateTimeEdit {
    min-height:50px;
    max-height:50px;
    border-radius:2px;
    border:1px solid gray;
}

QDateTimeEdit::drop-down {
    border:0px;
    width:30px;
}

QDateTimeEdit::down-arrow {
    image:url(:/res/png/icon_down_arrow);
    width:20px;
    height:20px;
}

QCalendarWidget {
    border:1px solid lightgray;
    background-color:rgb(255, 255, 255);
}

QCalendarWidget QAbstractItemView {
    font-size:20px;
    outline:0px;
}

QCalendarWidget QAbstractItemView:disabled {
    color:#D3D3D3;
}

QCalendarWidget QAbstractItemView:enabled {
    color:#000000;
    background-color:rgb(255, 255, 255);
    selection-color:rgb(255, 255, 255);
    selection-background-color:rgb(0, 141, 75);
}

QCalendarWidget QSpinBox#qt_calendar_yearedit {
    background:rgb(224, 226, 231);
    height:34px;
    width:125px;
    selection-background-color:rgb(0, 141, 75);
}

QCalendarWidget QSpinBox::down-button,QSpinBox::up-button {
    width:50px;
    border:0px;
}

QCalendarWidget QSpinBox::down-arrow {
    image:url(:/res/png/Arrow_Down);
    width:30px;
    height:30px;
}

QCalendarWidget QSpinBox::up-arrow {
    image:url(:/res/png/Arrow_Up);
    width:30px;
    height:30px;
}

QCalendarWidget QToolButton {
    background-color:rgb(255, 255, 255);
    height:34px;
    width:125px;
    color:#000000;
}

QCalendarWidget QToolButton:hover {
    border:1px solid lightgray;
    background:rgb(0, 141, 75);
}

QCalendarWidget QToolButton::menu-indicator#qt_calendar_monthbutton {
    subcontrol-position:right center;
    subcontrol-origin:padding;
    qproperty-icon:url(:/res/png/icon_down_arrow);
    width:30px;
    height:30px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon:url(:/res/png/icon_left);
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon:url(:/res/png/icon_right);
}

QCalendarWidget QToolButton QMenu {
    background-color:rgb(224, 226, 231);
    width:120px;
    border:1px solid lightgray;
}

QCalendarWidget QToolButton QMenu::item {
    width:120px;
    text-align: center;
    border:1px dotted gray;
}

QCalendarWidget QToolButton QMenu::item:selected {
    color:#FFFFFF;
    background:rgb(0, 141, 75);
}
